{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "packages/shared/src/**/*.test.ts",
    "apps/api/src/**/*.test.ts",
    "apps/api/src/fixtures",
    "scripts"
  ]
}
