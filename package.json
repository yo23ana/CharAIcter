{
  "name": "charaicter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && vite build --config apps/web/vite.config.ts",
    "build:api": "tsc --build apps/api/tsconfig.json",
    "build:shared": "tsc --build packages/shared/tsconfig.json",
    "build:web": "npm run build:shared && vite build --config apps/web/vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:chars",
    "check:chars": "node scripts/check-special-characters.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:web\" \"npm:dev:api\"",
    "dev:api": "npm run build:shared && tsx watch apps/api/src/server.ts",
    "dev:web": "npm run build:shared && vite --config apps/web/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "language:benchmark": "npm run build:shared && tsx scripts/language-benchmark.ts",
    "lint": "eslint .",
    "start:api": "node apps/api/dist/server.js",
    "test": "npm run build:shared && vitest run",
    "test:agent": "tsx scripts/testing-agent.ts",
    "typecheck": "tsc --build && tsc --project tsconfig.tests.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.6.1",
    "fasttext.wasm": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "franc": "^6.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
