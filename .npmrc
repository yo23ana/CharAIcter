# Supply-chain protection for every npm install in this repository.

# Never run install scripts from packages: they are the usual route for npm
# malware. The packages here work without theirs (see the reviewed list in
# scripts/check-lockfile.mjs); `npm run <script>` still works.
ignore-scripts=true

# Install only versions published at least 7 days ago, so a hijacked release
# is usually found and removed before it can reach this project.
min-release-age=7

# Never install dependencies straight from git repositories.
allow-git=none
